# Bytecode from the authoring tools in tools/ and
# assets/docs/buidling_to_voxel/ -- generated on whatever machine ran them.
__pycache__/
*.py[cod]

# agent worktrees and local scratch
.claude/

# The authoring tools in tools/ and assets/docs/buidling_to_voxel/ read an
# imported ROM cache on whatever machine runs them. Nothing derived from
# cartridge bytes is committable.
*.gb
*.gbc
*.sav
*.sgm
data/generated/
assets/generated/
